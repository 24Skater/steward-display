# Steward Display configuration. Copy to .env and fill in.

# --- docker compose -------------------------------------------------------
# The database password docker-compose.yml gives Postgres and the app.
POSTGRES_PASSWORD=change-me-to-something-long
# The port Display is published on, and on which address. Behind a reverse
# proxy on the same machine use 127.0.0.1, so nobody can skip the proxy.
PORT=3000
BIND_ADDRESS=0.0.0.0
# The code the first-run setup page asks for. Leave empty and Display prints a
# random one in its log (docker compose logs app, the line starting [setup]).
SETUP_CODE=

# The address people use to reach Display, e.g. https://display.yourchurch.org.
# Links in emails (password resets, invitations) point here. Without it, Display
# cannot email links: it never builds them from the request, which anyone can fake.
PUBLIC_URL=

# Outgoing email, optional: invitations, password resets, confirming addresses.
# The same names Steward VBS uses. Without it, invitations give the owner a link
# to pass on, and tools/reset-password.mjs resets passwords.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Steward Display <display@yourchurch.org>"

# Single sign-on with Steward ID (Auth0), optional. All three or none; needs
# PUBLIC_URL too, for the address Auth0 sends people back to. The callback to
# register in Auth0 is <PUBLIC_URL>/api/auth/sso/callback.
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# AUTH0_BUTTON_LABEL=Continue with Steward ID
# Email-and-password sign-in stays on unless set to false. Turn it off only
# once everyone signs in with Steward ID.
# ALLOW_LOCAL_PASSWORD_LOGIN=true

# --- running without docker compose ---------------------------------------
# Where the database is. docker compose builds this from POSTGRES_PASSWORD.
DATABASE_URL="postgresql://display:display@localhost:5432/display"

# Set to true when Display runs behind a reverse proxy (Caddy, nginx, Traefik).
# Rate limits then use the visitor's address from X-Forwarded-For, and cookies
# are marked Secure when the proxy says the visitor used https. Leave false when
# Display is reachable directly: the header could otherwise be forged.
TRUST_PROXY=false
# How many proxies sit in front of Display (a CDN in front of Caddy is 2). The
# visitor's address is read that many entries from the right of
# X-Forwarded-For; entries further left are whatever the visitor sent.
TRUSTED_PROXY_HOPS=1

# --- hosted Steward platform only -----------------------------------------
# Leave unset on your own server. When set, each church is reached at
# {slug}-stewarddisplay.app.<PLATFORM_ROOT_DOMAIN> and setup is disabled.
# PLATFORM_ROOT_DOMAIN=

# --- tests ------------------------------------------------------------------
# A database the integration tests may wipe. Never the one above.
# TEST_DATABASE_URL="postgresql://display:display@localhost:5432/display_test"
