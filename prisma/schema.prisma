// Steward Display - database schema.
//
// Every model is classified in src/server/tenancy.ts as tenanted (carries a
// non-nullable orgId, scoped automatically) or global. tenancy.test.ts fails
// when a model here is in neither set.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  EDITOR
}

enum UserTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

/// A church. The tenant root.
model Org {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  invitations Invitation[]
  screens     Screen[]
  presets     Preset[]
  settings    OrgSettings?
  devices     Device[]
  pairings    Pairing[]
}

/// A person. Global: one login may serve several churches.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  /// scrypt, see src/server/password.ts. Null once a user signs in only with SSO.
  passwordHash    String?
  /// Set when the person proves they receive mail at `email`: a verification
  /// link, a password-reset link, or accepting an emailed invitation.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  memberships Membership[]
  sessions    Session[]
  tokens      UserToken[]
  invited     Invitation[] @relation("InvitedBy")
}

/// A single-use link emailed to a person: reset a password, or verify an address.
/// Global, like the user it belongs to. Only the SHA-256 of the token is stored.
model UserToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   UserTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// An invitation to join a church, by email, with a role. Accepted once.
model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        Role      @default(EDITOR)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, email])
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
}

/// A screen layout. The widgets live in `document`, validated by src/server/schemas.ts.
model Screen {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  document  Json
  /// Bumped on every save. Doubles as the TV's ETag and as the editor's conflict check.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([orgId, updatedAt])
}

/// A saved widget configuration a church reuses.
model Preset {
  id         String   @id @default(cuid())
  orgId      String
  widgetType String
  name       String
  data       Json
  createdAt  DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgSettings {
  id        String   @id @default(cuid())
  orgId     String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// A paired TV. Authenticates with a bearer token; only its SHA-256 is stored.
model Device {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  screenId   String?
  /// Null until the TV has collected its token from the pairing it came from.
  tokenHash  String?   @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  screen  Screen?  @relation(fields: [screenId], references: [id], onDelete: SetNull)
  pairing Pairing?

  @@index([orgId])
}

/// A TV asking to be paired: shows `code`, polls with a secret only it holds.
model Pairing {
  id             String    @id @default(cuid())
  orgId          String
  code           String
  pollSecretHash String    @unique
  expiresAt      DateTime
  deviceId       String?   @unique
  /// Set when the TV has been handed its device token. A pairing pays out once.
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([orgId, code])
}
